{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dottr",
      "camelcase": "Dottr",
      "title": "dottr",
      "scope": "source.dottr",
      "file-types": [
        "dotfile"
      ],
      "injection-regex": "^dottr$",
      "class-name": "TreeSitterDottr",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Tree-sitter grammar for dottr manifests",
    "authors": [
      {
        "name": "Tendayi Kamucheka"
      }
    ]
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
